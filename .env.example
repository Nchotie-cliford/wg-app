# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On serverless (Vercel), this MUST be a POOLED connection string, otherwise
# every cold function opens a fresh Postgres connection (full TLS handshake)
# and you can exhaust the connection limit.
#   - Neon:     use the "-pooler" host   ...@ep-xxx-pooler.<region>.aws.neon.tech/db
#   - Supabase: use the 6543 pgbouncer port with ?pgbouncer=true
#   - or Prisma Accelerate:  prisma://accelerate.prisma-data.net/?api_key=...
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional: a DIRECT (unpooled) URL for running `prisma migrate` locally.
# Not read by the app at runtime. If you use a pooled DATABASE_URL, run
# migrations with:  DATABASE_URL="$DIRECT_URL" npx prisma migrate deploy
# DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth / sessions  (REQUIRED in production)
# ---------------------------------------------------------------------------
# Signs the session cookie (HMAC-SHA256). Generate with:  openssl rand -base64 32
# If unset in production the app refuses to start. Rotating it logs everyone out.
SESSION_SECRET=""

# Stable key so encrypted Server Action references stay valid across the
# multiple serverless instances Vercel runs. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Cron  (recurring-bill generation -> /api/cron/recurring)
# ---------------------------------------------------------------------------
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# Generate with:  openssl rand -base64 32
CRON_SECRET=""

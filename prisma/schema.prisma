generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // On serverless, point this at a POOLED endpoint (PgBouncer / Neon `-pooler` /
  // Prisma Accelerate). Direct connections make every cold function pay a full
  // TLS + Postgres handshake and can exhaust the connection limit. See .env.example.
  url = env("DATABASE_URL")
}

model Member {
  id       Int     @id @default(autoincrement())
  name     String
  emoji    String
  colorHex String
  // Stores a scrypt hash ("scrypt:<salt>:<hash>"), never a plaintext PIN.
  // Legacy plaintext values are upgraded transparently on next successful login.
  pin      String  @default("0000")
  isAway   Boolean @default(false)
  order    Int     @unique

  // --- auth / anti-bruteforce ---
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Bumped to invalidate every existing session for this member (e.g. on PIN change).
  sessionVersion    Int       @default(0)

  cleaningWeeks    CleaningWeek[]
  expenses         Expense[]
  shoppingItems    ShoppingItem[]
  events           Event[]
  paymentsSent     Payment[]         @relation("paymentFrom")
  paymentsReceived Payment[]         @relation("paymentTo")
  recurringPaidBy  RecurringExpense[] @relation("recurringPaidBy")
  recurringAddedBy RecurringExpense[] @relation("recurringAddedBy")
  expenseShares    ExpenseShare[]
  blocks           Block[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  from      Member   @relation("paymentFrom", fields: [fromId], references: [id])
  fromId    Int
  to        Member   @relation("paymentTo", fields: [toId], references: [id])
  toId      Int
  amount    Float
  createdAt DateTime @default(now())

  @@index([fromId])
  @@index([toId])
  @@index([createdAt])
}

model CleaningTask {
  id            Int               @id @default(autoincrement())
  name          String
  emoji         String
  order         Int               @unique
  cleaningWeeks CleaningWeek[]
  subtasks      CleaningSubtask[]
}

model CleaningSubtask {
  id     Int          @id @default(autoincrement())
  task   CleaningTask @relation(fields: [taskId], references: [id])
  taskId Int
  label  String
  order  Int
  checks SubtaskCheck[]

  @@index([taskId])
}

model CleaningWeek {
  id            Int          @id @default(autoincrement())
  weekStart     DateTime
  task          CleaningTask @relation(fields: [taskId], references: [id])
  taskId        Int
  member        Member       @relation(fields: [memberId], references: [id])
  memberId      Int
  done          Boolean      @default(false)
  subtaskChecks SubtaskCheck[]

  @@unique([weekStart, taskId])
  @@index([weekStart])
  @@index([memberId])
  @@index([taskId])
}

model SubtaskCheck {
  id             Int             @id @default(autoincrement())
  cleaningWeek   CleaningWeek    @relation(fields: [cleaningWeekId], references: [id], onDelete: Cascade)
  cleaningWeekId Int
  subtask        CleaningSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  subtaskId      Int
  done           Boolean         @default(false)

  @@unique([cleaningWeekId, subtaskId])
  @@index([cleaningWeekId])
  @@index([subtaskId])
}

model Expense {
  id          Int               @id @default(autoincrement())
  title       String
  category    String
  amount      Float
  paidBy      Member            @relation(fields: [paidById], references: [id])
  paidById    Int
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now())
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id])
  recurringId Int?
  shares      ExpenseShare[]

  @@index([date])
  @@index([paidById])
  @@index([category])
  @@index([recurringId, date])
}

model ExpenseShare {
  id        Int     @id @default(autoincrement())
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId Int
  member    Member  @relation(fields: [memberId], references: [id])
  memberId  Int
  cents     Int

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model Block {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  Int
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([startDate, endDate])
}

model RecurringExpense {
  id        Int       @id @default(autoincrement())
  title     String
  category  String
  amount    Float
  paidBy    Member    @relation("recurringPaidBy", fields: [paidById], references: [id])
  paidById  Int
  addedBy   Member    @relation("recurringAddedBy", fields: [addedById], references: [id])
  addedById Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@index([active])
  @@index([paidById])
  @@index([addedById])
}

model ShoppingItem {
  id        Int      @id @default(autoincrement())
  name      String
  addedBy   Member   @relation(fields: [addedById], references: [id])
  addedById Int
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([addedById])
  @@index([done, createdAt])
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  note      String?
  addedBy   Member   @relation(fields: [addedById], references: [id])
  addedById Int
  createdAt DateTime @default(now())

  @@index([addedById])
  @@index([date])
}
